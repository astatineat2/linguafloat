# Only reviewed project inputs enter the development repository.
/*
!/.gitignore
!/.gitattributes
!/AGENTS.md
!/pyproject.toml
!/README.md
!/CHANGELOG.md
!/RELEASES.md
!/LICENSE
!/THIRD_PARTY_NOTICES.md
!/LinguaFloat.spec
!/LinguaFloatUpdater.spec
!/*requirements.lock.txt
!/src/
!/tests/
!/scripts/
!/photo/
!/release/
!/LICENSES/
!/docs/
!/public-download/
!/source-materials/
__pycache__/
*.py[cod]
*.sqlite*
*.log
*.pem
*.key
.env*
docs/*
!docs/public/
!docs/verification-v0.11.0.md
source-materials/*
!source-materials/README.md
!source-materials/source-lock.json
!source-materials/overrides/
